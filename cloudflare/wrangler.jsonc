{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mini-task-board",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mini-task-board",
      "database_id": "1b7948ce-3d33-4ec5-b75a-77f984709048",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
