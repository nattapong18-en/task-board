{
  "name": "mini-task-board-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-assets.mjs",
    "dev": "npm run build && wrangler dev",
    "test": "node --test",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mini-task-board --local",
    "db:migrate:remote": "wrangler d1 migrations apply mini-task-board --remote"
  },
  "devDependencies": {
    "wrangler": "^4.33.1"
  }
}

